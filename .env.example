# Copy to .env.local (ignored by git) and fill in. Never commit real values and
# never paste them into chat. Load with:  set -a; . ./.env.local; set +a
#
# Cloudflare account ID: dashboard -> Workers & Pages -> right-hand sidebar.
CF_ACCOUNT_ID=your-account-id-here
#
# A READ-ONLY API token with exactly one permission:
#   Account -> Account Analytics -> Read
# Create it at dash.cloudflare.com/profile/api-tokens ("Create Custom Token").
# Limit it to this one account. It cannot change anything.
CF_API_TOKEN=your-read-only-token-here
#
# Optional: the Web Analytics site tag, only once Web Analytics is enabled
# (Web Analytics -> your site -> Manage site -> "Site tag").
CF_WEB_ANALYTICS_SITE_TAG=
#
# Optional: report on a different origin (defaults to https://getpaddock.com).
# PADDOCK_SITE_URL=https://getpaddock.com
